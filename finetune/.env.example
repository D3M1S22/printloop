# Copy to finetune/.env (never committed).
ROBOFLOW_API_KEY=
# Optional overrides (defaults: finetune/data, finetune/checkpoints, finetune/results, finetune/export)
FDMFT_DATA_DIR=
FDMFT_CHECKPOINTS_DIR=
FDMFT_RESULTS_DIR=
FDMFT_EXPORT_DIR=
# Optional: an existing llama.cpp checkout for the GGUF export (otherwise it is cloned at a pinned commit)
LLAMA_CPP_DIR=
