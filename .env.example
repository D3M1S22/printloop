# Copiare in .env e compilare. MAI committare .env.

# LLM multimodale: Gemma 4 su vLLM, droplet AMD MI300X (OpenAI-compatibile).
# Vuoto = modalità offline: diagnosi dichiarata dall'operatore e proposta a regole.
LLM_BASE_URL=http://<DROPLET_IP>:8000/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-4-26B-A4B-it
LLM_TIMEOUT_S=120
LLM_MAX_TOKENS=4096

# Slicer. Ogni progetto si lavora con lo slicer che l'ha creato (tag OrcaSlicer nel 3MF -> Orca, altrimenti
# BambuStudio): riesportare un progetto Orca con BambuStudio ne perde le impostazioni specifiche.
# Vuoti = ricerca automatica (PATH, ~/.local/bin/OrcaSlicer.AppImage, /opt/BambuStudio).
ORCA_SLICER_BIN=
BAMBU_STUDIO_BIN=
# Forza un unico slicer per tutti i progetti (sconsigliato).
SLICER_BIN=

# Loop
PRINTLOOP_MAX_ITERATIONS=3
PRINTLOOP_MIN_CONFIDENCE=0.6
PRINTLOOP_MAX_IMAGE_PX=1536

# Stretch (Modo 1): Bambu Lab P1S in LAN-only + Developer Mode
PRINTER_IP=
PRINTER_SERIAL=
PRINTER_ACCESS_CODE=
