# Copy to .env and fill in. NEVER commit .env.

# Multimodal LLM: Gemma 4 on vLLM, AMD MI300X droplet (OpenAI-compatible).
# Empty = offline mode: diagnosis stated by the operator and rule-based proposals.
LLM_BASE_URL=http://<DROPLET_IP>:8000/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-4-26B-A4B-it
LLM_TIMEOUT_S=120
LLM_MAX_TOKENS=4096

# Defect detector: fine-tuned Gemma 4 E4B (docs/printloop/07_VISION_MODEL.md), OpenAI-compatible.
# Used by Mode 1 (every live frame) and Mode 2 (every uploaded photo, as a hint to the 26B). Empty = off.
# infra/serve_vision_e4b.sh serves it on :8082 as printloop-vision-e4b; on a llama.cpp router use the preset name
# (e.g. Gemma-4-E4B-3dPrint-v1-Q8). Do not share a one-model-at-a-time router with the 26B while Mode 1 runs.
VISION_LLM_BASE_URL=
VISION_LLM_API_KEY=
VISION_LLM_MODEL=printloop-vision-e4b
VISION_LLM_TIMEOUT_S=30
# Mode 2: E4B labels as a hint for the 26B, disagreement goes to the operator (09_MODE2_TWO_MODELS.md)
MODE2_DETECTOR=true

# Mode 1, live monitoring (docs/printloop/08_MODE1_LIVE.md)
MODE1_SOURCE=replay              # replay | p1s | url
MODE1_REPLAY_DIR=                # folder of recorded frames on the API host
MODE1_SNAPSHOT_URL=
MODE1_INTERVAL_S=10
MODE1_PAUSE_K=3
MODE1_PAUSE_N=4
MODE1_ALERT_K=4
MODE1_ALERT_N=6
MODE1_CLEAR_N=6
MODE1_RECORD_ALL=false

# Slicer. Each project is processed with the slicer that created it (OrcaSlicer tag in the 3MF -> Orca, otherwise
# BambuStudio): re-exporting an Orca project with BambuStudio loses its Orca-specific settings.
# Empty = automatic search (PATH, ~/.local/bin/OrcaSlicer.AppImage, /opt/BambuStudio).
ORCA_SLICER_BIN=
BAMBU_STUDIO_BIN=
# Forces a single slicer for every project (not recommended).
SLICER_BIN=

# Loop
PRINTLOOP_MAX_ITERATIONS=3
PRINTLOOP_MIN_CONFIDENCE=0.6
PRINTLOOP_MAX_IMAGE_PX=1536

# Mode 1 P1S camera source: Bambu Lab P1S in LAN-only + Developer Mode (PRINTER_SERIAL is for the MQTT link, not implemented yet)
PRINTER_IP=
PRINTER_SERIAL=
PRINTER_ACCESS_CODE=
